Grammar

    0 $accept: CompileUnit $end

    1 CompileUnit: FuncDef
    2            | VarDecl
    3            | CompileUnit FuncDef
    4            | CompileUnit VarDecl

    5 FuncDef: BasicType T_ID T_L_PAREN FormalParamListOpt T_R_PAREN Block

    6 FormalParamListOpt: ε
    7                   | FormalParamList
    8                   | T_VOID

    9 FormalParamList: FormalParamDecl
   10                | FormalParamList T_COMMA FormalParamDecl

   11 FormalParamDecl: BasicType T_ID

   12 Block: T_L_BRACE T_R_BRACE
   13      | T_L_BRACE BlockItemList T_R_BRACE

   14 BlockItemList: BlockItem
   15              | BlockItemList BlockItem

   16 BlockItem: Statement
   17          | VarDecl

   18 VarDecl: VarDeclExpr T_SEMICOLON

   19 VarDeclExpr: BasicType VarDef
   20            | VarDeclExpr T_COMMA VarDef

   21 VarDef: T_ID
   22       | T_ID T_ASSIGN Expr

   23 BasicType: T_INT

   24 Statement: T_RETURN Expr T_SEMICOLON
   25          | Block
   26          | IfStmt
   27          | WhileStmt
   28          | BreakStmt
   29          | ContinueStmt
   30          | Expr T_SEMICOLON
   31          | T_SEMICOLON

   32 IfStmt: T_IF T_L_PAREN Expr T_R_PAREN Statement
   33       | T_IF T_L_PAREN Expr T_R_PAREN Statement T_ELSE Statement

   34 WhileStmt: T_WHILE T_L_PAREN Expr T_R_PAREN Statement

   35 BreakStmt: T_BREAK T_SEMICOLON

   36 ContinueStmt: T_CONTINUE T_SEMICOLON

   37 Expr: AssignExpr

   38 AssignExpr: LVal T_ASSIGN AssignExpr
   39           | LOrExp

   40 LOrExp: LOrExp T_LOR LAndExp
   41       | LAndExp

   42 LAndExp: LAndExp T_LAND EqExp
   43        | EqExp

   44 EqExp: EqExp EqOp RelExp
   45      | RelExp

   46 EqOp: T_EQ
   47     | T_NE

   48 RelExp: RelExp RelOp AddExp
   49       | AddExp

   50 RelOp: T_LT
   51      | T_LE
   52      | T_GT
   53      | T_GE

   54 AddExp: AddExp AddOp MulExp
   55       | MulExp

   56 MulExp: MulExp MulOp UnaryExp
   57       | UnaryExp

   58 AddOp: T_ADD
   59      | T_SUB

   60 MulOp: T_MUL
   61      | T_DIV
   62      | T_MOD

   63 UnaryExp: PrimaryExp
   64         | T_SUB UnaryExp
   65         | T_LNOT UnaryExp
   66         | T_ID T_L_PAREN T_R_PAREN
   67         | T_ID T_L_PAREN RealParamList T_R_PAREN

   68 PrimaryExp: T_L_PAREN Expr T_R_PAREN
   69           | T_DIGIT
   70           | LVal

   71 RealParamList: Expr
   72              | RealParamList T_COMMA Expr

   73 LVal: T_ID


